# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Virtual environments (the M0 dev venv lives in-repo, gitignored) ---
.venv/
venv/
env/
ENV/

# --- Build / packaging artifacts ---
/dist/
/build/
# PyInstaller per-spec output (backend/alice-backend.spec → backend/dist|build)
backend/dist/
backend/build/
*.spec.bak
# PyInstaller scratch
*.manifest
*.toc
*.pkg
__pyinstaller__/
# Generated app icon (rebuild via packaging/macos/build_icon.sh)
assets/icons/*.icns

# --- Native packaging outputs ---
*.dmg
*.app/
*.exe
*.AppImage
*.deb

# --- Downloaded models (multi-GB; never committed; fetched first-run to ~/.alice/models) ---
/models/
*.gguf
*.safetensors
*.npz

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Logs / local env ---
*.log
.env
.env.local
